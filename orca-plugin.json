{
  "manifestVersion": 2,
  "id": "todo-list",
  "name": "Daily To-Do List",
  "version": "0.4.0",
  "description": "A sidebar to-do list for the small tasks of your day: timed desktop reminders, repeats and durations, with the current and next to-do in the status bar. 處理一天內小任務的側欄待辦清單：到點桌面提醒、可重複與設定持續時間，狀態列顯示進行中與下一件事。",
  "license": "Apache-2.0",
  "author": {
    "name": "LazyJerry",
    "url": "https://github.com/lazyjerry"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "src/worker.ts",
  "contributes": {
    "panels": [
      {
        "id": "todo-list",
        "title": "Daily To-Do List",
        "icon": "calendar",
        "entry": "src/panel.tsx",
        "ui": "components"
      }
    ],
    "commands": [
      { "id": "todo-list.showStatus", "title": "Daily To-Do List: Show Current and Next To-Do" }
    ],
    "statusBarItems": [
      { "id": "now", "icon": "play", "tone": "warning", "tooltip": "Todo in progress", "command": "todo-list.showStatus" },
      { "id": "next", "icon": "bell", "tone": "accent", "tooltip": "Next todo", "command": "todo-list.showStatus" }
    ]
  },
  "capabilities": [
    { "kind": "storage:own" },
    { "kind": "notifications:show" },
    { "kind": "workspace:read" },
    { "kind": "workspace:write" }
  ]
}
